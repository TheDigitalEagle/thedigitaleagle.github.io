---
import Base from "./Base.astro";
const { frontmatter } = Astro.props;
const date = frontmatter.date ? new Date(frontmatter.date) : null;
const dateText = date?.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---
<Base title={frontmatter.title} description={frontmatter.description}>
  <article class="post">
    <p class="mono"><a href="/blog/">notes</a>{dateText && <> · <time datetime={date.toISOString()}>{dateText}</time></>}</p>
    <h1>{frontmatter.title}</h1>
    {frontmatter.description && <p class="lede">{frontmatter.description}</p>}
    <div class="body"><slot /></div>
  </article>
</Base>
<style>
  .post { max-width: 68ch; }
  .post h1 { margin: 10px 0 18px; font-size: clamp(2.2rem, 5vw, 3.6rem); }
  .post .mono a { text-decoration: none; color: var(--ash); }
  .body { margin-top: 32px; font-size: 1.05rem; }
  .body :global(h2) { margin-top: 2.4rem; }
  .body :global(ul), .body :global(ol) { padding-left: 1.3rem; }
  .body :global(li) { margin-bottom: 0.4rem; }
  .body :global(img) { max-width: 100%; border: 1px solid var(--line); }
  .body :global(strong) { color: #fff; font-weight: 600; }
</style>
