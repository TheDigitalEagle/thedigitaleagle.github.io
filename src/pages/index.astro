---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { featured } from "../data/projects";
import { tagline, summary, areas, philosophy, tools } from "../data/lab";
---
<Base>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Independent engineering lab · kullhem.io</p>
      <h1>{tagline}</h1>
      <p class="lede">{summary}</p>
      <div class="actions">
        <a class="btn primary" href="/projects/">See the projects</a>
        <a class="btn" href="https://github.com/Kullhem-io" target="_blank" rel="noopener">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          Kullhem-io on GitHub
        </a>
      </div>
    </div>
    <div class="hero-logo">
      <img src="/kullhem-labs-logo.png" alt="Kullhem Labs: a crow with a K cut into its wing" width="1166" height="378" />
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>What lives here</h2>
      <p>Rough ideas becoming working systems.</p>
    </div>
    <div class="grid fill-last">
      {areas.map((a) => (
        <div class="card">
          <h3>{a.title}</h3>
          <p>{a.blurb}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Featured projects</h2>
      <a href="/projects/">All projects →</a>
    </div>
    <div class="grid">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section class="section two-col">
    <div class="card">
      <p class="eyebrow">Engineering philosophy</p>
      <ol class="philosophy">
        {philosophy.map((line) => <li>{line}</li>)}
      </ol>
    </div>
    <div class="card">
      <p class="eyebrow">Common tools and patterns</p>
      <ul class="tools">
        {tools.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </section>

  <section class="section status">
    <p class="eyebrow">Status</p>
    <p>
      Many repositories here are experiments, prototypes, or active workbenches. Some are polished.
      Some are intentionally messy while the idea is still being discovered. That is part of the lab.
    </p>
    <p class="muted">
      This site is a static Astro build on GitHub Pages. Nothing here needs a backend, and the source is
      <a href="https://github.com/TheDigitalEagle/thedigitaleagle.github.io" target="_blank" rel="noopener">public</a>.
    </p>
  </section>
</Base>
<style>
  .hero { display: grid; grid-template-columns: 1.15fr 1fr; gap: 40px; align-items: center; }
  .lede { font-size: 1.1rem; color: var(--muted); max-width: 56ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .hero-logo { background: var(--logo-tile); border-radius: 20px; padding: 28px; box-shadow: 0 20px 60px rgba(124, 58, 237, 0.18); }
  .hero-logo img { display: block; width: 100%; height: auto; }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .philosophy { margin: 0; padding-left: 1.2rem; display: grid; gap: 6px; }
  .philosophy li { font-weight: 600; }
  .philosophy li::marker { color: var(--accent); font-family: var(--mono); font-weight: 400; }
  .tools { margin: 0; padding-left: 1.2rem; display: grid; gap: 6px; color: var(--muted); }
  .status { max-width: 68ch; }
  @media (max-width: 820px) {
    .hero { grid-template-columns: 1fr; }
    .hero-logo { order: -1; padding: 20px; }
    .two-col { grid-template-columns: 1fr; }
  }
</style>
