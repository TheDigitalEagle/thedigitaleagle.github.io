---
import Base from "../layouts/Base.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { featured, spotlight } from "../data/projects";
import { tagline, summary, areas, philosophy, tools, status } from "../data/lab";
---
<Base>
  <section class="hero">
    <p class="mono">independent engineering lab · est. 2023 · kullhem.io</p>
    <h1><span data-glitch data-text={`${tagline.lead} ${tagline.em}`}>{tagline.lead} <em>{tagline.em}</em></span></h1>
    <p class="lede">{summary}</p>
    <div class="actions">
      <a class="btn primary" href="/projects/">open the catalog <span class="arrow">→</span></a>
      <a class="btn" href="https://github.com/Kullhem-io" target="_blank" rel="noopener">github.com/Kullhem-io <span class="arrow">↗</span></a>
    </div>
  </section>

  <div class="rule"><span class="no">§01</span><span>what lives here</span></div>
  <section>
    <ol class="areas">
      {areas.map((a) => (
        <li>
          <h3>{a.title}</h3>
          <p>{a.blurb}</p>
        </li>
      ))}
    </ol>
  </section>

  <div class="rule"><span class="no">§02</span><span>spotlight · {spotlight.area.toLowerCase()}</span></div>
  <section class="spot">
    <div class="spot-copy">
      <h2><a href={spotlight.repo} target="_blank" rel="noopener">{spotlight.name}</a></h2>
      <p class="spot-pitch">{spotlight.tagline}</p>
      <p class="spot-desc">{spotlight.description}</p>
      <ul class="wins">
        <li>Nothing installed on the controlled machine.</li>
        <li>Zero network exposure. Even the clipboard rides the USB cable.</li>
        <li>Works at the login screen, elevated prompts, installers, safe mode. Wherever a USB keyboard works.</li>
        <li>Survives a reboot. The device just re-enumerates.</li>
        <li>Fails safe. Any disconnect releases every key and button. Nobody likes a stuck modifier.</li>
      </ul>
      <div class="actions">
        <a class="btn primary" href={spotlight.repo} target="_blank" rel="noopener">read the readme <span class="arrow">↗</span></a>
        <span class="mono">{spotlight.languages.join(" / ")}</span>
      </div>
    </div>
    <figure class="spec">
      <figcaption class="mono">fig. 1 · one keyboard, one mouse, two machines</figcaption>
      <pre class="flow">{`  your desk
      |
      v
+------------------+        +--------------------------+
|  linux desktop   |  LAN   |  raspberry pi 4          |
|  (input router)  | -----> |  usb gadget "beaglewing" |
+------------------+        +------------+-------------+
                                         | usb-c
                                         v
                            +--------------------------+
                            |  any usb host. it sees   |
                            |  a keyboard, a mouse,    |
                            |  and one vendor device.  |
                            +--------------------------+`}</pre>
    </figure>
  </section>

  <div class="rule"><span class="no">§03</span><span>also on the bench</span></div>
  <section class="catalog">
    {featured.map((p, i) => <ProjectRow project={p} index={i + 1} />)}
    <p class="more mono"><a href="/projects/">full catalog <span class="arrow">→</span></a></p>
  </section>

  <div class="rule"><span class="no">§04</span><span>how the lab works</span></div>
  <section class="doctrine">
    <ol>
      {philosophy.map((line) => <li>{line}</li>)}
    </ol>
    <aside>
      <p class="mono">common tools and patterns</p>
      <ul class="tools">{tools.map((t) => <li>{t}</li>)}</ul>
    </aside>
  </section>

  <div class="rule"><span class="no">§05</span><span>status</span></div>
  <section class="status">
    <p>{status}</p>
    <p class="mono">This site is a static Astro build on GitHub Pages. No backend, no tracking, <a href="https://github.com/TheDigitalEagle/thedigitaleagle.github.io" target="_blank" rel="noopener">source is public</a>.</p>
  </section>
</Base>
<style>
  .hero { max-width: 720px; padding: 24px 0 8px; }
  .hero h1 { margin: 14px 0 22px; position: relative; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 8px; }

  /* the slip */
  [data-glitch] { position: relative; display: inline-block; }
  [data-glitch].is-glitching::before, [data-glitch].is-glitching::after {
    content: attr(data-text); position: absolute; left: 0; top: 0; width: 100%; color: var(--bone); overflow: hidden; pointer-events: none;
  }
  [data-glitch].is-glitching::before { color: var(--violet); transform: translate(-3px, -1px); clip-path: inset(10% 0 55% 0); animation: slip 0.42s steps(3) 1; }
  [data-glitch].is-glitching::after { color: var(--signal); transform: translate(3px, 1px); clip-path: inset(60% 0 8% 0); animation: slip 0.42s steps(3) 1 reverse; }
  @keyframes slip { 0% { clip-path: inset(10% 0 55% 0); } 50% { clip-path: inset(40% 0 20% 0); } 100% { clip-path: inset(70% 0 5% 0); } }

  .areas { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0 48px; counter-reset: area; }
  .areas li { counter-increment: area; padding: 18px 0 18px 44px; position: relative; border-top: 1px solid var(--line-soft); }
  .areas li::before { content: counter(area, decimal-leading-zero); position: absolute; left: 0; top: 22px; font-family: var(--mono); font-size: 0.74rem; color: var(--violet); letter-spacing: 0.08em; }
  .areas h3 { font-size: 1.35rem; margin-bottom: 4px; }
  .areas p { margin: 0; color: var(--ash); font-size: 0.95rem; }

  .spot { display: grid; grid-template-columns: 1.1fr 1fr; gap: 40px; align-items: start; }
  .spot > * { min-width: 0; }
  .spot h2 a { text-decoration: none; }
  .spot h2 a:hover { color: var(--violet); }
  .spot-pitch { font-size: 1.2rem; }
  .spot-desc { color: var(--ash); }
  .wins { margin: 0 0 20px; padding: 0; list-style: none; display: grid; gap: 8px; }
  .wins li { padding-left: 22px; position: relative; font-size: 0.97rem; }
  .wins li::before { content: "✓"; position: absolute; left: 0; color: var(--signal); font-family: var(--mono); }
  .spec { margin: 0; border: 1px solid var(--line); background: var(--ink-2); padding: 14px 16px 6px; position: relative; }
  .spec::after { content: ""; position: absolute; right: -1px; bottom: -1px; width: 14px; height: 14px; border-right: 1px solid var(--violet); border-bottom: 1px solid var(--violet); }
  .spec figcaption { margin-bottom: 8px; }
  .flow { margin: 0; background: none; border: 0; padding: 0; font-family: var(--mono); font-size: 0.74rem; line-height: 1.35; color: var(--bone); overflow-x: auto; }

  .more { margin: 18px 0 0; }
  .more a { text-decoration: none; }
  .more .arrow { color: var(--violet); }

  .doctrine { display: grid; grid-template-columns: 1.3fr 1fr; gap: 40px; align-items: start; }
  .doctrine ol { list-style: none; margin: 0; padding: 0; counter-reset: rule; }
  .doctrine ol li { counter-increment: rule; font-family: var(--serif); font-size: clamp(1.5rem, 2.6vw, 2rem); line-height: 1.2; padding: 14px 0 14px 56px; border-top: 1px solid var(--line-soft); position: relative; }
  .doctrine ol li::before { content: counter(rule, upper-roman); position: absolute; left: 0; top: 22px; font-family: var(--mono); font-size: 0.74rem; color: var(--violet); letter-spacing: 0.1em; }
  .doctrine aside { border-left: 1px solid var(--line); padding-left: 24px; }
  .tools { margin: 8px 0 0; padding: 0; list-style: none; color: var(--ash); display: grid; gap: 6px; }
  .tools li::before { content: "— "; color: var(--violet); }

  .status { max-width: 66ch; }
  .status .mono { margin-top: 12px; }

  @media (max-width: 820px) {
    .areas, .spot, .doctrine { grid-template-columns: 1fr; }
    .doctrine aside { border-left: 0; padding-left: 0; border-top: 1px solid var(--line); padding-top: 16px; }
    .doctrine ol li { padding-left: 44px; }
  }
</style>
