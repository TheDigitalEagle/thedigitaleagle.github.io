---
import Base from "../../layouts/Base.astro";
import { getPosts } from "../../lib/posts";
const posts = getPosts();
---
<Base title="Notes" description="Lab notes from Kullhem Labs: write-ups, edge cases, and what was learned building things.">
  <p class="eyebrow">Notes</p>
  <h1>Lab notes</h1>
  <p class="lede">Write-ups, weird edge cases, and what was learned. Also available as <a href="/rss.xml">RSS</a>.</p>
  <ul class="posts">
    {posts.map((p) => (
      <li class="card">
        <time class="muted" datetime={p.date.toISOString()}>{p.dateText}</time>
        <h3><a href={p.route}>{p.title}</a></h3>
        {p.description && <p>{p.description}</p>}
      </li>
    ))}
  </ul>
</Base>
<style>
  .lede { color: var(--muted); }
  .posts { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 12px; }
  .posts time { font-family: var(--mono); font-size: 0.8rem; }
  .posts h3 { margin: 4px 0 6px; }
</style>
