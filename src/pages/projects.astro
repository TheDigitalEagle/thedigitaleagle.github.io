---
import Base from "../layouts/Base.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { projects } from "../data/projects";
const order = ["active", "research", "prototype", "archived"] as const;
const sorted = [...projects].sort((a, b) => order.indexOf(a.status) - order.indexOf(b.status));
---
<Base title="Catalog" description="Public projects from Kullhem Labs: hardware bridges, multi-agent engines, local LLM research, GPU containers, and small tools.">
  <p class="mono">catalog · {sorted.length} public entries</p>
  <h1>What the lab <em>has built.</em></h1>
  <p class="lede">
    Everything public under <a href="https://github.com/Kullhem-io" target="_blank" rel="noopener">Kullhem-io</a>, minus housekeeping.
    This list is curated by hand. The repos are the source of truth, and some of them are mid-thought.
  </p>
  <p class="legend mono">
    <span class="tag status-active">active</span> shipping and in use ·
    <span class="tag status-research">research</span> finding out ·
    <span class="tag status-prototype">prototype</span> works on my machine ·
    <span class="tag status-archived">dormant</span> did its job
  </p>
  <section class="catalog">
    {sorted.map((p, i) => <ProjectRow project={p} index={i} full />)}
  </section>
</Base>
<style>
  h1 { margin: 10px 0 18px; }
  .legend { margin: 0 0 40px; line-height: 2; }
</style>
