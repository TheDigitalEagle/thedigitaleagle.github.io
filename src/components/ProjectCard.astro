---
import type { Project } from "../data/projects";
import { STATUS_LABEL } from "../data/projects";
interface Props { project: Project; compact?: boolean }
const { project, compact = false } = Astro.props;
---
<article class="card project">
  <div class="project-top">
    <h3><a href={project.repo} target="_blank" rel="noopener">{project.name}</a></h3>
    <span class={`chip status-${project.status}`}>{STATUS_LABEL[project.status]}</span>
  </div>
  <p class="tagline">{project.tagline}</p>
  {!compact && <p class="desc">{project.description}</p>}
  <div class="project-meta">
    <div class="chips">{project.languages.map((l) => <span class="chip">{l}</span>)}</div>
    <a class="repo" href={project.repo} target="_blank" rel="noopener">Repo →</a>
  </div>
</article>
<style>
  .project { display: flex; flex-direction: column; gap: 10px; }
  .project-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .project-top h3 { margin: 0; }
  .project-top h3 a { color: var(--text); }
  .tagline { color: var(--text); margin: 0; }
  .desc { font-size: 0.95rem; margin: 0; }
  .project-meta { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-top: auto; padding-top: 6px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .repo { font-size: 0.9rem; white-space: nowrap; }
</style>
