---
// The resident. Sits somewhere different on every page. The eye is real.
interface Props { pose: "hero" | "corner" | "peek" | "margin" | "lost" }
const { pose } = Astro.props;
---
<div class={`crow crow-${pose}`} aria-hidden="true">
  <div class="crow-body">
    <img src="/crow-ink.png" alt="" width="393" height="364" />
    <span class="eye"><span class="pupil"></span></span>
  </div>
</div>
<div class="motes" aria-hidden="true">
  <i></i><i></i><i></i><i></i><i></i>
</div>
<style>
  .crow { position: absolute; z-index: 0; pointer-events: none; }
  .crow-body { position: relative; width: 100%; }
  .crow-body img { display: block; width: 100%; height: auto; opacity: 1; filter: drop-shadow(0 0 40px rgba(139, 92, 246, 0.05)); }
  .eye {
    position: absolute; left: 70.4%; top: 6.6%; width: 6.4%; aspect-ratio: 1;
    border-radius: 50%; background: var(--violet);
    box-shadow: 0 0 14px rgba(139, 92, 246, 0.7), 0 0 34px rgba(139, 92, 246, 0.35);
    transform-origin: center; animation: blink 9s infinite;
    display: grid; place-items: center;
  }
  .pupil { width: 36%; aspect-ratio: 1; border-radius: 50%; background: var(--ink); transition: transform 0.35s ease-out; }
  @keyframes blink {
    0%, 42%, 46%, 100% { transform: scaleY(1); }
    44% { transform: scaleY(0.08); }
    71% { transform: scaleY(1); } 72% { transform: scaleY(0.08); } 73% { transform: scaleY(1); }
  }
  .crow-hero { top: 88px; right: -60px; width: clamp(280px, 40vw, 520px); }
  .crow-corner { bottom: -24px; right: 24px; width: clamp(200px, 24vw, 300px); transform: scaleX(-1); opacity: 0.85; }
  .crow-peek { top: 180px; right: 6%; width: clamp(150px, 18vw, 230px); transform: rotate(-6deg); opacity: 0.8; }
  .crow-margin { top: 60vh; left: -80px; width: clamp(180px, 22vw, 300px); transform: scaleX(-1) rotate(3deg); opacity: 0.6; }
  .crow-lost { top: 50%; left: 50%; width: clamp(240px, 36vw, 420px); transform: translate(-50%, -30%) scaleX(-1); opacity: 0.7; }
  .crow-lost .eye { animation-duration: 3s; }
  @media (max-width: 820px) {
    .crow-hero { top: 120px; right: -70px; width: 62vw; opacity: 0.5; }
    .crow-margin { top: auto; bottom: 0; left: -60px; }
    .crow-peek { top: 120px; right: -10px; }
  }
  .motes { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .motes i { position: absolute; bottom: -10px; width: 3px; height: 3px; border-radius: 50%; background: var(--violet); opacity: 0; box-shadow: 0 0 8px var(--violet); animation: rise linear infinite; }
  .motes i:nth-child(1) { left: 12%; animation-duration: 38s; animation-delay: -4s; }
  .motes i:nth-child(2) { left: 31%; animation-duration: 52s; animation-delay: -20s; width: 2px; height: 2px; }
  .motes i:nth-child(3) { left: 57%; animation-duration: 44s; animation-delay: -11s; }
  .motes i:nth-child(4) { left: 73%; animation-duration: 61s; animation-delay: -33s; width: 2px; height: 2px; }
  .motes i:nth-child(5) { left: 88%; animation-duration: 47s; animation-delay: -27s; }
  @keyframes rise {
    0% { transform: translate(0, 0); opacity: 0; }
    8% { opacity: 0.55; }
    50% { transform: translate(14px, -50vh); }
    92% { opacity: 0.4; }
    100% { transform: translate(-10px, -104vh); opacity: 0; }
  }
</style>
<script>
  const eye = document.querySelector<HTMLElement>(".crow .eye");
  const pupil = document.querySelector<HTMLElement>(".crow .pupil");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (eye && pupil && !reduce) {
    const flipped = !!eye.closest(".crow-corner, .crow-margin, .crow-lost");
    let raf = 0;
    window.addEventListener("mousemove", (e) => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const r = eye.getBoundingClientRect();
        const dx = e.clientX - (r.left + r.width / 2);
        const dy = e.clientY - (r.top + r.height / 2);
        const dist = Math.hypot(dx, dy) || 1;
        const max = r.width * 0.22;
        const x = (dx / dist) * Math.min(max, dist / 40) * (flipped ? -1 : 1);
        const y = (dy / dist) * Math.min(max, dist / 40);
        pupil.style.transform = `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px)`;
      });
    }, { passive: true });
  }
  const glitchy = document.querySelectorAll<HTMLElement>("[data-glitch]");
  if (glitchy.length && !reduce) {
    const tick = () => {
      glitchy.forEach((el) => { el.classList.add("is-glitching"); setTimeout(() => el.classList.remove("is-glitching"), 420); });
      setTimeout(tick, 7000 + Math.random() * 9000);
    };
    setTimeout(tick, 2500);
  }
</script>
